[Unit]
Description=Tunnelside: selected sites and addresses go around the VPN
After=network-pre.target vpn-killswitch.service wg-quick@wg0.service NetworkManager.service systemd-resolved.service
Wants=network-pre.target

[Service]
ExecStart=/usr/bin/python3 /opt/tunnelside/tunnelsided.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
